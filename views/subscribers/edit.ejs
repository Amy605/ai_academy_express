<form action="/subscribers/<%= subscriber._id %>?_method=PUT" method="POST">
    <div class="form-group">
      <label>Nom</label>
      <input type="text" name="name" value="<%= subscriber.name %>" required>
    </div>
    <div class="form-group">
      <label>Email</label>
      <input type="email" name="email" value="<%= subscriber.email %>" required>
    </div>
    <div class="form-group">
      <label>Code Postal</label>
      <input type="text" name="zipCode" value="<%= subscriber.zipCode %>" required>
    </div>
    <button type="submit" class="btn btn-primary">Mettre à jour</button>
  </form>