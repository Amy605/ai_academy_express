<h1>Profil utilisateur: <%= user.fullName %></h1>

<table class="table" border="1">
  <tr>
    <th>Nom complet</th>
    <td><%= user.fullName %></td>
  </tr>
  <tr>
    <th>Email</th>
    <td><%= user.email %></td>
  </tr>
  <tr>
    <th>Code Postal</th>
    <td><%= user.zipCode %></td>
  </tr>
</table>

<% if (user.subscribedAccount) { %>
  <h4>Cet utilisateur est lié à un compte abonné.</h4>
<% } %>

<div class="button-group mt-3">
  <a href="/users" class="btn btn-primary">Tous les utilisateurs</a>
  <a href="/users/<%= user._id %>/edit" class="btn btn-info">Modifier</a>
  <a href="/users/api-token" class="btn btn-secondary">Mon Token API</a>
  <a href="/users/<%= user._id %>/delete?_method=DELETE" 
     class="btn btn-danger"
     onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur?')">
    Supprimer
  </a>
</div>
